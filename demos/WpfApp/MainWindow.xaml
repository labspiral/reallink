<Window x:Class="WpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5,5,5,5" >
            <Button Content="Start" Width="100" Command="{Binding StartCommand}" />
            <Button Content="Reconnect" Width="100" Command="{Binding ReconnectCommand}" />
            <Button Content="Send" Width="100" Command="{Binding SendCommand}" />
            <Button Content="Request" Width="100" Command="{Binding RequestCommand}" />
            <Button Content="Stop" Width="100" Command="{Binding StopCommand}" />
        </StackPanel >
        <ListBox ItemsSource="{Binding LogItems}" Grid.Row="1"/>
    </Grid>
</Window>
